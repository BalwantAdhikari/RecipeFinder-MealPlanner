# Pin this project to the public npm registry.
# The machine default points at a corporate Artifactory; this assignment must
# not install or publish through it. npm reads only ./.npmrc (not ancestors),
# so each package directory carries its own copy.
registry=https://registry.npmjs.org/

# Auth token is read from the NPM_TOKEN environment variable.
# NEVER paste a literal token here — this file is committed to a public repo.
# Set it in your shell instead:
#   export NPM_TOKEN=npm_xxxxxxxxxxxxxxxxxxxx
//registry.npmjs.org/:_authToken=${NPM_TOKEN}
